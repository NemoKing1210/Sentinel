  "homepage": "https://github.com/NemoKing1210/Sentinel",
  "repository": {
    "type": "git",
    "url": "https://github.com/NemoKing1210/Sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/NemoKing1210/Sentinel/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check:versions": "node scripts/check-versions.mjs",
    "changelog": "node scripts/extract-changelog.mjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "release": "node scripts/release.mjs",
    "test": "node --test scripts/lib/versions.test.mjs",
    "ci": "npm run lint && npm run format:check && npm run build && npm run check:versions && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tauri-apps/api": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "country-flag-icons": "^1.6.20",
    "i18next": "^24.2.3",
    "motion": "^13.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.4.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
